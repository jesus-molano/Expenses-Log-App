NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required to protect scheduled server jobs. Vercel Cron sends it as
# Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# Optional, used only when the user presses the AI analyze action.
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-2.5-flash

# Optional, used for real push notification delivery.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
