NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required to protect scheduled server jobs. Vercel Cron sends it as
# Authorization: Bearer $CRON_SECRET. The reminder hour chosen in Settings
# needs the cron to run hourly: on Vercel Pro use "0 * * * *" in vercel.json;
# on Hobby set the GitHub variable PUSH_CRON_URL and the secret CRON_SECRET so
# .github/workflows/push-reminders.yml calls the endpoint every hour.
CRON_SECRET=

# Optional, used only when the user presses the AI analyze action.
GEMINI_API_KEY=
# Defaults: gemini-3.5-flash-lite, falling back to gemini-3.1-flash-lite when
# the first one is retired, out of quota or down. gemini-2.5-* is legacy.
GEMINI_API_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional, used for real push notification delivery.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
